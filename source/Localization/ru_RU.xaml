    <sys:String x:Key="LOCHowLongToBeatSearchHint" xml:space="preserve">Параметры:
    -time		Время до прохождения (например: -time=5h / -time=&lt;50min / -time=&gt;50s / -time=10min&lt;&gt;5h)
    -np		Вы не играли в игру
    -fav		Игра должна быть в избранном
    -stores={n}	Фильтр по названию магазина (например: -stores=steam / -stores=steam,epic)
    -status={n}	Фильтр по имени статуса (например: -status=played / -status=played,playing)</sys:String>

