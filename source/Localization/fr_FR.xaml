    <!-- Platform and storefront mapping -->

    <sys:String x:Key="LOCHowLongToBeatPlatformsMappingDescription" xml:space="preserve">Chaque ligne relie une plateforme Playnite (de votre base de bibliothèque) au nom de plateforme envoyé à HowLongToBeat lors de l'envoi du temps de jeu.
Si la valeur HLTB n'est pas définie (----), le plugin utilise PC par défaut à l'envoi.</sys:String>
