<UserControl x:Class="HowLongToBeat.Views.HltbPlatformsSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:AttachedProperties="clr-namespace:CommonPluginsShared.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:CommonPluginsControls.Controls"
             xmlns:HowLongToBeat="clr-namespace:HowLongToBeat"
             xmlns:hltm="clr-namespace:HowLongToBeat.Models"
             xmlns:hlte="clr-namespace:HowLongToBeat.Models.Enumerations"
             xmlns:hlts="clr-namespace:HowLongToBeat.Services"
             xmlns:hltb="clr-namespace:HowLongToBeat.Behaviors"
             xmlns:converters="clr-namespace:CommonPluginsShared.Converters"
             xmlns:converters1="clr-namespace:CommonPlayniteShared.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance HowLongToBeat:HowLongToBeatSettingsViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

            <DockPanel
                       LastChildFill="True">
                <Label DockPanel.Dock="Top"
                       Content="{DynamicResource LOCHowLongToBeatPlatformsMappingDescription}"/>

                <ListView Name="PART_GridPlatformsList"
                          Margin="0,10,0,0"
                          MinHeight="100"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListViewItem}"
                               BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="Focusable"
                                    Value="False"/>
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="380">
                                <GridViewColumn.Header>
                                    <TextBlock Text="{DynamicResource LOCHowLongToBeatMappingColumnPlayniteOrigin}"
                                               FontWeight="SemiBold"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Text="{Binding Platform.Name}"
                                                       FontWeight="SemiBold">
                                                <TextBlock.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel>
                                                            <TextBlock Text="{DynamicResource LOCHowLongToBeatMappingPlaynitePlatformIdToolTip}"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding PlaynitePlatformId}"
                                                                       TextWrapping="Wrap"
                                                                       MaxWidth="360"/>
                                                        </StackPanel>
                                                    </ToolTip>
                                                </TextBlock.ToolTip>
                                            </TextBlock>

                                            <StackPanel Orientation="Horizontal"
                                                        Opacity="0.75"
                                                        Margin="0,2,0,0">
                                                <TextBlock Text="{Binding PlayniteSpecificationId}"
                                                           FontSize="11"
                                                           Visibility="{Binding HasPlayniteSpecificationId, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text=" · "
                                                           FontSize="11"
                                                           Visibility="{Binding HasPlayniteSpecificationId, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding PlaynitePlatformId}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Width="280">
                                <GridViewColumn.Header>
                                    <TextBlock Text="{DynamicResource LOCHowLongToBeatMappingColumnHltbTarget}"
                                               FontWeight="SemiBold"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <ComboBox hltb:SelectorBehaviors.EnumSource="{x:Type hlte:HltbPlatform}"
                                                      SelectedValue="{Binding HltbPlatform}"
                                                      ToolTip="{Binding HltbPlatformDisplay}"/>

                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Opacity="0.75"
                                                       FontStyle="Italic"
                                                       Text="{DynamicResource LOCHowLongToBeatMappingPlatformDefaultHint}">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHltbPlatformConfigured}"
                                                                         Value="False">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
</UserControl>
