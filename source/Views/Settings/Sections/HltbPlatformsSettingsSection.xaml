<UserControl x:Class="HowLongToBeat.Views.HltbPlatformsSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:HowLongToBeat="clr-namespace:HowLongToBeat"
             xmlns:hlte="clr-namespace:HowLongToBeat.Models.Enumerations"
             xmlns:hltb="clr-namespace:HowLongToBeat.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance HowLongToBeat:HowLongToBeatSettingsViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <TextBlock DockPanel.Dock="Top"
                   Style="{DynamicResource BaseTextBlockStyle}"
                   TextWrapping="Wrap"
                   Text="{DynamicResource LOCHowLongToBeatPlatformsMappingDescription}"/>

        <ListView Name="PART_GridPlatformsList"
                  Margin="0,10,0,0"
                  MinHeight="100"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}"
                       BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Setter Property="Focusable"
                            Value="False"/>
                    <Setter Property="HorizontalContentAlignment"
                            Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.View>
                <GridView>
                    <GridViewColumn Width="380">
                        <GridViewColumn.Header>
                            <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Text="{DynamicResource LOCHowLongToBeatMappingColumnPlayniteOrigin}"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               Text="{Binding Platform.Name}">
                                        <TextBlock.ToolTip>
                                            <ToolTip>
                                                <StackPanel>
                                                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                                               FontWeight="SemiBold"
                                                               Text="{DynamicResource LOCHowLongToBeatMappingPlaynitePlatformIdToolTip}"/>
                                                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                                               Text="{Binding PlaynitePlatformId}"
                                                               TextWrapping="Wrap"
                                                               MaxWidth="360"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal"
                                                Opacity="0.75"
                                                Margin="0,2,0,0">
                                        <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Text="{Binding PlayniteSpecificationId}"
                                                   Visibility="{Binding HasPlayniteSpecificationId, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Text=" · "
                                                   Visibility="{Binding HasPlayniteSpecificationId, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                                   FontSize="{DynamicResource FontSizeSmall}"
                                                   Text="{Binding PlaynitePlatformId}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Width="280">
                        <GridViewColumn.Header>
                            <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                       FontWeight="SemiBold"
                                       Text="{DynamicResource LOCHowLongToBeatMappingColumnHltbTarget}"/>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <ComboBox hltb:SelectorBehaviors.EnumSource="{x:Type hlte:HltbPlatform}"
                                              SelectedValue="{Binding HltbPlatform}"
                                              ToolTip="{Binding HltbPlatformDisplay}"/>

                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Opacity="0.75"
                                               FontStyle="Italic"
                                               Text="{DynamicResource LOCHowLongToBeatMappingPlatformDefaultHint}">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}"
                                                   BasedOn="{StaticResource BaseTextBlockStyle}">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHltbPlatformConfigured}"
                                                                 Value="False">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
