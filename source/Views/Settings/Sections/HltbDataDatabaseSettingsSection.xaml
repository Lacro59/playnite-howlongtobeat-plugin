<UserControl x:Class="HowLongToBeat.Views.HltbDataDatabaseSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:HowLongToBeat="clr-namespace:HowLongToBeat"
             xmlns:hlte="clr-namespace:HowLongToBeat.Models.Enumerations"
             xmlns:converters1="clr-namespace:CommonPlayniteShared.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance HowLongToBeat:HowLongToBeatSettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly">
        <StackPanel>
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,8">
                <TextBlock Style="{DynamicResource ViewColumnLabelText}"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Text="{DynamicResource LOCHltbDefaultDataProvider}"/>

                <ComboBox SelectedValue="{Binding Settings.DefaultDataProvider}"
                          VerticalAlignment="Center"
                          MinWidth="160">
                    <ComboBox.ItemsSource>
                        <x:Array Type="{x:Type sys:Enum}">
                            <hlte:DataProvider>HowLongToBeat</hlte:DataProvider>
                            <hlte:DataProvider>Vndb</hlte:DataProvider>
                        </x:Array>
                    </ComboBox.ItemsSource>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                                       Text="{Binding Converter={converters1:ObjectToStringConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <CheckBox Name="cbAutoImport"
                      IsChecked="{Binding Settings.AutoImport}"
                      Content="{DynamicResource LOCCommonAutoImport}"/>

            <CheckBox Name="cbAutoAccept"
                      Margin="0,8,0,0"
                      IsChecked="{Binding Settings.AutoAccept}"
                      Content="{DynamicResource LOCHowLongToBeatAutoAccept}"/>

            <CheckBox Name="cbShowWhenMismatch"
                      Margin="0,8,0,0"
                      IsChecked="{Binding Settings.ShowWhenMismatch}"
                      Content="{DynamicResource LOCHowLongToBeatShowWhenMismatch}"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox IsChecked="{Binding Settings.UseMatchValue}"
                          VerticalAlignment="Center"
                          Content="{DynamicResource LOCHowLongToBeatUseMatchValue}"/>

                <StackPanel Orientation="Horizontal"
                            Grid.Column="2"
                            VerticalAlignment="Center">
                    <Slider Width="200"
                            VerticalAlignment="Center"
                            Name="PART_SliderMAtchValue"
                            Value="{Binding Settings.MatchValue, FallbackValue=95}"
                            Minimum="75"
                            Maximum="100"
                            IsSnapToTickEnabled="True"
                            TickFrequency="1"/>
                    <TextBlock Style="{DynamicResource BaseTextBlockStyle}"
                               Width="50"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               HorizontalAlignment="Center"
                               Text="{Binding ElementName=PART_SliderMAtchValue, Path=Value, StringFormat={}{0}%}"/>
                </StackPanel>
            </Grid>

            <TextBlock Margin="0,16,0,8"
                       Style="{DynamicResource SectionHeaderText}"
                       Text="{DynamicResource LOCCommonDatabase}"/>

            <StackPanel Orientation="Horizontal">
                <Button Name="btAddData"
                        Content="{DynamicResource LOCUpdateAll}"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"/>
                <Button Name="btRemoveData"
                        Content="{DynamicResource LOCClearAll}"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
