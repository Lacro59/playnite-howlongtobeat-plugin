<UserControl x:Class="HowLongToBeat.Views.HltbDataExportSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:HowLongToBeat="clr-namespace:HowLongToBeat"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance HowLongToBeat:HowLongToBeatSettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly">
        <StackPanel>
            <TextBlock Style="{DynamicResource SectionHeaderText}"
                       Text="{DynamicResource LOCHowLongToBeatExport}"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="PART_BtnExportCsvComma"
                        Content="{DynamicResource LOCHowLongToBeatExportCsvComma}"
                        MinHeight="26"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"/>
                <Button x:Name="PART_BtnExportCsvSemicolon"
                        Content="{DynamicResource LOCHowLongToBeatExportCsvSemicolon}"
                        MinHeight="26"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"/>
                <Button x:Name="PART_BtnExportJson"
                        Content="{DynamicResource LOCHowLongToBeatExportJson}"
                        MinHeight="26"
                        VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PART_ExportFolder"
                         Grid.Column="0"
                         MinHeight="26"
                         VerticalAlignment="Center"
                         ToolTip="{DynamicResource LOCHowLongToBeatExportFolderTooltip}"/>
                <Button Grid.Column="2"
                        x:Name="PART_BtnBrowseExportFolder"
                        Content="{DynamicResource LOCBrowseLabel}"
                        MinHeight="26"
                        VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
