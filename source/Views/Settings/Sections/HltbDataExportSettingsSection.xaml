<UserControl x:Class="HowLongToBeat.Views.HltbDataExportSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:HowLongToBeat="clr-namespace:HowLongToBeat"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance HowLongToBeat:HowLongToBeatSettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly">
        <StackPanel>
            <TextBlock Style="{DynamicResource SectionHeaderText}"
                       Text="{DynamicResource LOCHowLongToBeatExport}"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource LOCHowLongToBeatExportCsvComma}"
                        Command="{Binding ExportCsvCommaCommand}"
                        MinHeight="26"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"/>
                <Button Content="{DynamicResource LOCHowLongToBeatExportCsvSemicolon}"
                        Command="{Binding ExportCsvSemicolonCommand}"
                        MinHeight="26"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"/>
                <Button Content="{DynamicResource LOCHowLongToBeatExportJson}"
                        Command="{Binding ExportJsonCommand}"
                        MinHeight="26"
                        VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         MinHeight="26"
                         VerticalAlignment="Center"
                         Text="{Binding ExportFolder, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{DynamicResource LOCHowLongToBeatExportFolderTooltip}"/>
                <Button Grid.Column="2"
                        Content="{DynamicResource LOCBrowseLabel}"
                        Command="{Binding BrowseExportFolderCommand}"
                        MinHeight="26"
                        VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
