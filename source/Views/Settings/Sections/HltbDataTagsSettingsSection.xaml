<UserControl x:Class="HowLongToBeat.Views.HltbDataTagsSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:HowLongToBeat="clr-namespace:HowLongToBeat"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance HowLongToBeat:HowLongToBeatSettingsViewModel}">

    <StackPanel VerticalAlignment="Top">
        <CheckBox x:Name="cbEnableTag"
                  IsChecked="{Binding Settings.EnableTag}"
                  Content="{DynamicResource LOCHowLongToBeatAddTagDescription}"/>

        <StackPanel Orientation="Horizontal"
                    Margin="0,10,0,0">
            <Button x:Name="PART_BtnAddTag"
                    Content="{DynamicResource LOCAddTitle}"
                    MinHeight="26"
                    MinWidth="80"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding Settings.EnableTag}"/>
            <Button x:Name="PART_BtnRemoveTag"
                    Content="{DynamicResource LOCRemoveTitle}"
                    MinHeight="26"
                    MinWidth="80"
                    IsEnabled="{Binding Settings.EnableTag}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
