<UserControl x:Class="HowLongToBeat.Views.HltbDataVndbSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:HowLongToBeat="clr-namespace:HowLongToBeat"
             xmlns:hlte="clr-namespace:HowLongToBeat.Models.Enumerations"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance HowLongToBeat:HowLongToBeatSettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalOnly">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{DynamicResource ViewColumnLabelText}"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           Text="{DynamicResource LOCHltbDefaultVndbSpeed}"/>

                <ComboBox SelectedValue="{Binding Settings.DefaultVndbSpeed}"
                          SelectedValuePath="Tag"
                          VerticalAlignment="Center"
                          MinWidth="160">
                    <ComboBoxItem Content="{DynamicResource LOCHltbVndbSpeedSlow}"
                                  Tag="{x:Static hlte:DataType.Classic}"/>
                    <ComboBoxItem Content="{DynamicResource LOCHltbVndbSpeedNormal}"
                                  Tag="{x:Static hlte:DataType.Average}"/>
                    <ComboBoxItem Content="{DynamicResource LOCHltbVndbSpeedFast}"
                                  Tag="{x:Static hlte:DataType.Median}"/>
                    <ComboBoxItem Content="{DynamicResource LOCHltbVndbSpeedTotal}"
                                  Tag="{x:Static hlte:DataType.Rushed}"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
